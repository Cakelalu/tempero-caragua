{
    "name": "tempero-caragua-api",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "nodemon --exec tsx src/server.ts",
        "build": "tsup src/server.ts --format cjs --clean",
        "start": "node dist/server.cjs",
        "postinstall": "prisma skills sync || exit 0"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "bcryptjs": "^3.0.3",
        "body-parser": "^2.3.0",
        "cors": "^2.8.6",
        "express": "^5.2.1",
        "google-auth-library": "^11.3.1",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.4.0",
        "mustache": "^4.2.0",
        "mysql2": "^3.24.6",
        "slug": "^12.0.1",
        "uuid": "^14.0.2",
        "zod": "^4.6.5"
    },
    "devDependencies": {
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.6",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/multer": "^2.3.0",
        "@types/mustache-express": "^1.2.5",
        "@types/node": "^26.2.0",
        "@types/slug": "^5.0.9",
        "dotenv": "^18.0.8",
        "nodemon": "^3.1.14",
        "prisma": "^6.19.3",
        "ts-node": "^10.9.2",
        "tsup": "^9.0.0",
        "tsx": "^4.23.15",
        "typescript": "^6.0.3"
    },
    "allowScripts": {
        "prisma@7.9.1": true,
        "@prisma/engines@7.9.1": true
    }
}
