// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  MODERATOR
}

model User {
  id             String   @id @default(uuid())
  nome           String
  nomeUsuario    String
  dataNascimento DateTime?
  email          String   @unique
  numeroTel      String?
  imagemPerfil   String?
  imagemBanner   String?
  biografia      String?
  senha          String
  tipo           Role     @default(USER) // Define 'USER' como valor padrão
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  posts          Post[]
  favorites      Favorited[]
  likes          Liked[]
  seguindo       Followed[] @relation("Seguindo")
  seguidores     Followed[] @relation("Seguidores")
}

model Post {
  id              String   @id @default(uuid())
  slug            String   @unique
  titulo          String
  conteudo        String
  imagens         String?
  legendas        String?
  autorId         String   @default(uuid())
  autor           User     @relation(fields: [autorId], references: [id])
  dataPostagem    DateTime @default(now())
  dataAtualizacao DateTime @default(now())
  dataDelecao     DateTime?
  favorited       Favorited[]
  tags            Tagged[]
  liked           Liked[]
}

model Favorited {
  id              String   @id @default(uuid())
  userId          String   @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  postSlug        String
  post            Post     @relation(fields: [postSlug], references: [slug])

  @@unique([userId, postSlug])
}

model Liked {
  id              String   @id @default(uuid())
  userId          String   @default(uuid())
  user            User     @relation(fields: [userId], references: [id])
  postSlug        String
  post            Post     @relation(fields: [postSlug], references: [slug])

  @@unique([userId, postSlug])
}

model Tag {
  id              String   @id @default(uuid())
  nome            String   @unique
  usos            Tagged[]
}

model Tagged {
  id              String   @id @default(uuid())
  tagNome         String
  tag             Tag      @relation(fields: [tagNome], references: [nome])
  postSlug        String
  post            Post     @relation(fields: [postSlug], references: [slug])

  @@unique([tagNome, postSlug])
}

model Followed {
  id              String   @id @default(uuid())
  perfilId        String
  perfil          User     @relation("Seguindo", fields: [perfilId], references: [id])
  seguidorId      String
  seguidor        User     @relation("Seguidores", fields: [seguidorId], references: [id])

  @@unique([perfilId, seguidorId])
}