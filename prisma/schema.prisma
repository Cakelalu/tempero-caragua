// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Language {
  PT
  EN
}

enum Color {
  Light
  Dark
}

model User {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique
  status    Boolean   @default(true)
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  currentLanguage Language @default(PT)
  currentColor Color  @default(Light)
  posts     Post[]

  @@map("users") // Mapeia a tabela para "users" no banco de dados
}

model Post {
  id      Int     @id @default(autoincrement())
  title   String
  slug String
  subtitle String?
  content String
  tags String[]
  userId  Int @map("user_id") // Mapeia a coluna para "user_id" no banco de dados
  user    User    @relation(fields: [userId], references: [id])

  @@map("posts") // Mapeia a tabela para "posts" no banco de dados
}

model User_Follow_User {
  idFollowed  Int
  idFollowing Int
  follow      Boolean
}

model User_Like_Post {
  idUser  Int
  idPost  Int
  like    Boolean
}

model User_Favorite_Post {
  idUser    Int
  idPost    Int
  favorite  Boolean
}

